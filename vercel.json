{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "pnpm build:vercel",
    "outputDirectory": "dist",
    "cleanUrls": true,
    "redirects": [
        {
            "source": "/writing/",
            "has": [
                {
                    "type": "host",
                    "value": "gocanto.sh"
                }
            ],
            "destination": "https://writing.gocanto.sh/",
            "permanent": true
        },
        {
            "source": "/writing/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "gocanto.sh"
                }
            ],
            "destination": "https://writing.gocanto.sh/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "writing.gocanto.sh"
                }
            ],
            "destination": "/writing/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/app/$1"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "writing.gocanto.sh"
                }
            ],
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none'"
                }
            ]
        },
        {
            "source": "/(.*)",
            "missing": [
                {
                    "type": "host",
                    "value": "writing.gocanto.sh"
                }
            ],
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'sha256-db0LEPBvXf/2CiWd7lMF1BJyZImu6Gx2K5wyV9CTKWg=' https://va.vercel-scripts.com; connect-src 'self' https://vitals.vercel-insights.com https://va.vercel-scripts.com; img-src 'self' https://oullin.io data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
                }
            ]
        }
    ]
}
