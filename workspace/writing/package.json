{
    "name": "@gocanto/writing",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#writing/posts-data": "./posts.data.ts",
        "#writing/article": "./.vitepress/article/index.ts",
        "#writing/article/article-page": "./.vitepress/article/article-page.ts",
        "#writing/analytics": "./.vitepress/analytics/index.ts",
        "#writing/analytics/writing-analytics": "./.vitepress/analytics/writing-analytics.ts",
        "#writing/bundle": "./.vitepress/bundle/index.ts",
        "#writing/bundle/writing-bundle": "./.vitepress/bundle/writing-bundle.ts",
        "#writing/posts": "./.vitepress/posts/index.ts",
        "#writing/posts/posts": "./.vitepress/posts/posts.ts",
        "#writing/posts/types": "./.vitepress/posts/types.ts",
        "#writing/rss": "./.vitepress/rss/index.ts",
        "#writing/rss/feed": "./.vitepress/rss/feed.ts",
        "#writing/search": "./.vitepress/search/index.ts",
        "#writing/search/index-search": "./.vitepress/search/index-search.ts",
        "#writing/seo": "./.vitepress/seo/index.ts",
        "#writing/seo/head": "./.vitepress/seo/head.ts",
        "#writing/*": "./.vitepress/*"
    },
    "scripts": {
        "dev": "PORTLESS_PORT=${PORTLESS_PORT:-1355} PORTLESS_HTTPS=${PORTLESS_HTTPS:-1} PORTLESS_SYNC_HOSTS=${PORTLESS_SYNC_HOSTS:-0} portless",
        "dev:site": "vitepress dev --host 0.0.0.0 --port ${PORT:-5175}",
        "build": "vitepress build && node .vitepress/scripts/externalize-inline-scripts.ts && node .vitepress/scripts/seo-guard.ts",
        "preview": "vitepress preview --host 0.0.0.0 --port ${PORT:-4175}",
        "lint": "make -C ../.. lint",
        "test": "vitest run --passWithNoTests",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0"
    },
    "devDependencies": {
        "@types/node": "^25.6.2",
        "portless": "^0.13.0",
        "typescript": "^6.0.3",
        "vitepress": "^1.6.4",
        "vitest": "^4.1.5",
        "vue": "^3.5.34",
        "vue-tsc": "^3.1.8"
    },
    "portless": {
        "name": "writing.gocanto-sh",
        "script": "dev:site"
    }
}
