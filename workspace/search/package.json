{
    "name": "@gocanto/search",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#search/*": "./src/*.ts"
    },
    "scripts": {
        "build": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
        "dev": "wrangler dev",
        "lint": "make -C ../.. lint",
        "test": "vitest run --passWithNoTests",
        "typecheck": "tsc -p tsconfig.json"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261114.1",
        "@types/node": "^25.6.2",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5",
        "wrangler": "^4.162.0"
    }
}
