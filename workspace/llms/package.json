        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@gocanto/domain": "workspace:*",
        "@gocanto/store": "workspace:*"
    },
    "devDependencies": {
        "@gocanto/app": "workspace:*",
        "@types/node": "^25.6.2",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    }
}
