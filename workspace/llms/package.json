{
    "name": "@gocanto/llms",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#llms/*": "./src/*.ts"
    },
    "exports": {
        ".": "./src/index.ts",
        "./kernel": "./src/kernel/index.ts",
        "./markdown": "./src/markdown/index.ts",
        "./llms-txt": "./src/llms-txt/index.ts",
        "./sitemap": "./src/sitemap/index.ts",
        "./bundle": "./src/bundle/index.ts"
    },
    "scripts": {
        "build": "tsx src/generate-markdown.ts",
        "format": "make -C ../.. ui-format",
        "format:check": "make -C ../.. ui-format",
        "lint": "make -C ../.. lint",
        "test": "vitest run --passWithNoTests",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@gocanto/domain": "workspace:*",
        "@gocanto/store": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.6.2",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    }
}
