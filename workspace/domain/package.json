{
    "name": "@gocanto/domain",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#domain/*": "./src/*.ts"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./text": {
            "types": "./src/text.ts",
            "default": "./src/text.ts"
        },
        "./purify": {
            "browser": {
                "types": "./src/purify.browser.ts",
                "default": "./src/purify.browser.ts"
            },
            "types": "./src/purify.node.ts",
            "default": "./src/purify.node.ts"
        },
        "./search": {
            "types": "./src/search.ts",
            "default": "./src/search.ts"
        }
    },
    "scripts": {
        "format": "make -C ../.. ui-format",
        "format:check": "make -C ../.. ui-format",
        "test": "vitest run --passWithNoTests",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@gocanto/store": "workspace:*",
        "dompurify": "^3.4.5",
        "jsdom": "^29.1.1"
    },
    "devDependencies": {
        "@types/jsdom": "^28.0.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    }
}
