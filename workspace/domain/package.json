{
    "name": "@gocanto/domain",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#domain/*": "./src/*.ts"
    },
    "exports": {
        ".": "./src/index.ts",
        "./kernel": "./src/kernel/index.ts",
        "./text": "./src/text/index.ts",
        "./search": "./src/search/index.ts",
        "./projects": "./src/projects/index.ts",
        "./work": "./src/work/index.ts",
        "./skills": "./src/skills/index.ts",
        "./recommendations": "./src/recommendations/index.ts",
        "./detail": "./src/detail/index.ts",
        "./url-guard": "./src/url-guard/index.ts",
        "./purify": {
            "browser": "./src/purify/sanitizer.browser.ts",
            "default": "./src/purify/sanitizer.node.ts"
        }
    },
    "scripts": {
        "format": "make -C ../.. ui-format",
        "format:check": "make -C ../.. ui-format",
        "lint": "make -C ../.. lint",
        "test": "vitest run --passWithNoTests",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@gocanto/store": "workspace:*",
        "dompurify": "^3.4.5",
        "jsdom": "^29.1.1"
    },
    "devDependencies": {
        "@types/jsdom": "^28.0.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    }
}
