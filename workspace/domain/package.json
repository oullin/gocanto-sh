{
    "name": "@gocanto/domain",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./text": {
            "types": "./src/text.ts",
            "default": "./src/text.ts"
        },
        "./search": {
            "types": "./src/search.ts",
            "default": "./src/search.ts"
        }
    },
    "scripts": {
        "format": "tsx ../../scripts/blank-lines.ts && oxfmt .",
        "format:check": "tsx ../../scripts/blank-lines.ts --check && oxfmt --check .",
        "test": "vitest run --passWithNoTests",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@gocanto/store": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    }
}
