{
    "name": "@gocanto/app",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#app/*": "./src/*"
    },
    "scripts": {
        "build": "vue-tsc -b && vite build --configLoader runner && tsx scripts/prerender.ts",
        "dev": "PORTLESS_PORT=${PORTLESS_PORT:-1355} PORTLESS_HTTPS=${PORTLESS_HTTPS:-1} PORTLESS_SYNC_HOSTS=${PORTLESS_SYNC_HOSTS:-0} portless",
        "dev:app": "vite --configLoader runner --host 0.0.0.0 --port ${PORT:-5173}",
        "format": "make -C ../.. ui-format",
        "format:check": "make -C ../.. ui-format",
        "lint": "oxlint .",
        "preview": "vite preview --configLoader runner --host 0.0.0.0",
        "test": "vitest run --passWithNoTests",
        "typecheck": "vue-tsc -b"
    },
    "dependencies": {
        "@gocanto/domain": "workspace:*",
        "@gocanto/store": "workspace:*",
        "@tailwindcss/vite": "^4.3.0",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-vue-next": "^1.0.0",
        "reka-ui": "^2.9.7",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.3.0",
        "vue": "^3.5.34"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "^25.6.2",
        "@vue/server-renderer": "^3.5.34",
        "@vue/test-utils": "^2.4.6",
        "happy-dom": "^15.11.7",
        "jsdom": "^29.1.1",
        "oxlint": "^1.31.0",
        "portless": "^0.13.0",
        "shadcn-vue": "^2.6.2",
        "typescript": "^6.0.3",
        "vite": "^8.0.11",
        "vitest": "^4.1.5",
        "vue-tsc": "^3.1.8"
    },
    "portless": {
        "name": "gocanto-sh",
        "script": "dev:app"
    }
}
