{
    "name": "@gocanto/store",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#store/*": "./src/*.ts"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./recommendations": {
            "types": "./src/recommendations.ts",
            "default": "./src/recommendations.ts"
        }
    },
    "scripts": {
        "format": "make -C ../.. ui-format",
        "format:check": "make -C ../.. ui-format",
        "test": "vitest run --passWithNoTests",
        "typecheck": "tsc -p tsconfig.json"
    },
    "devDependencies": {
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    }
}
