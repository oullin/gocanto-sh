{
    "name": "gocanto-sh",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "turbo run build --ui=stream --cache-dir storage/.cache/turbo",
        "dev": "turbo run dev --ui=stream --cache-dir storage/.cache/turbo",
        "format": "make format",
        "format-all": "make format-all",
        "format:check": "make ui-format-check",
        "lint": "turbo run lint --ui=stream --cache-dir storage/.cache/turbo",
        "perf:lighthouse": "pnpm dlx lighthouse@13.0.2 \"${PERF_URL:-http://localhost:4173/}\" --preset=desktop --quiet --chrome-flags='--headless=new --disable-gpu --no-sandbox --disable-extensions' --output=json --output-path=\"${LIGHTHOUSE_OUTPUT:-/tmp/gocanto-local-lighthouse.json}\"",
        "test": "turbo run test --ui=stream --cache-dir storage/.cache/turbo",
        "typecheck": "turbo run typecheck --ui=stream --cache-dir storage/.cache/turbo"
    },
    "devDependencies": {
        "oxc-parser": "^0.130.0",
        "oxfmt": "^0.49.0",
        "tsx": "^4.20.0",
        "turbo": "^2.9.12",
        "vitest": "^4.1.5"
    },
    "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
    "pnpm": {
        "overrides": {
            "stylus": "^0.64.0",
            "glob": "^13.0.6",
            "undici": "^7.28.0"
        }
    }
}
